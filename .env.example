# Copy to .env and fill in. Never commit .env.

# RPC endpoints (Base). Optional: if unset, Hardhat uses public defaults
# (https://sepolia.base.org / https://mainnet.base.org) so deploy is not blocked by HH117.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# Deployer wallet: SECRET private key (32 bytes = 64 hex digits after 0x → 66 characters with 0x).
# Common mistake: pasting a contract address (only 40 hex after 0x) — Hardhat will error (HH8).
# MetaMask: Account details → Show private key. Use a testnet-only wallet for Base Sepolia.
DEPLOYER_PRIVATE_KEY=

# BaseScan API key for contract verification (https://basescan.org/myapikey)
BASESCAN_API_KEY=
